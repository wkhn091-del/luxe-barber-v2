# ===========================================================================
#  client/.env — Luxe Barber web app (Vite)
# ===========================================================================
#
# Read by Vite at BUILD time, from this folder only — server/.env is invisible
# here, and nothing in it is needed here. Only VITE_-prefixed keys reach the
# code, and every one of them is compiled into the public JavaScript: nothing
# secret belongs in this file. Change a value, then rebuild.
# ===========================================================================

# [optional] Where the API lives.
# Empty → same origin. In dev, vite.config.js proxies /api to localhost:4000;
#         in production, when the API is served under the site's own /api.
# Set   → the API's ORIGIN only — no trailing slash, no /api (the client adds
#         it): https://luxe-barber-api.onrender.com
#         server/.env's CORS_ORIGINS must then list this site's origin.
VITE_API_URL=

# [needed for gallery uploads in the admin] Photos go from the browser straight
# to Cloudinary; the API never proxies image bytes. Use an UNSIGNED upload
# preset (Cloudinary → Settings → Upload → Upload presets) — unsigned presets
# are designed to be public — and lock it down there: images only, a maximum
# file size, one folder.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# [optional] The barber in 3D, in the homepage hero — a .glb (or .gltf) file.
# Put it in client/public/models/ and point here, e.g. /models/barber.glb, then
# rebuild. Empty → the barber pole stays. Draco- and Meshopt-compressed files
# both work; see src/components/BarberModel.jsx.
VITE_BARBER_MODEL_URL=

# [optional] The site's public address, for link previews (WhatsApp/Facebook)
# and the canonical URL — e.g. https://luxe-barber.co.il. On Vercel it can stay
# empty: VERCEL_PROJECT_PRODUCTION_URL is used automatically.
VITE_PUBLIC_SITE_URL=
